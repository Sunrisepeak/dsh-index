  "install": {
    "primary": {
      "label": {
        "en": "Install dsh",
        "zh": "安装 dsh",
        "zh-Hant": "安裝 dsh"
      },
      "command": "xlings install dsh pnpm -y"
    },
    "summary": {
      "en": "Don't have xlings yet?",
      "zh": "还没装 xlings?",
      "zh-Hant": "還沒安裝 xlings?"
    },
    "os": [
      {
        "id": "unix",
        "os": "Linux / macOS",
        "command": "curl -fsSL https://d2learn.org/xlings-install.sh | bash"
      },
      {
        "id": "windows",
        "os": "Windows · PowerShell",
        "command": "irm https://d2learn.org/xlings-install.ps1.txt | iex"
      }
    ]
  },
  "plugins": [
    ".xpkgindex/plugins/dsh.py"
  ],
  "docs": {
    "entries": [
      {
        "slug": "quick-start",
